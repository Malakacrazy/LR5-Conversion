{
  "id": "grasp-of-earth",
  "name": "Grasp of Earth",
  "type": "attachment",
  "faction": "phoenix",
  "traits": ["spell", "earth"],
  "unique": false,
  "printedCost": 1,
  "abilities": {
    "persistentEffects": [
      {
        "match": "self",
        "effect": { "name": "attachmentMyControlOnly" }
      },
      {
        "match": "self",
        "effect": { "name": "attachmentTraitRestriction", "value": "shugenja" }
      }
    ],
    "actions": [
      {
        "title": "Opponent's cards cannot join this conflict",
        "condition": { "op": "isDuringConflict" },
        "cost": [{ "name": "bowSelf" }],
        "effect": "prevent the opponent from bringing characters to the conflict",
        "gameAction": [
          {
            "name": "cardLastingEffect",
            "target": { "allCardsMatching": { "controller": "opponent" } },
            "params": {
              "effect": { "name": "cardCannot", "value": "moveToConflict" }
            }
          },
          {
            "name": "playerLastingEffect",
            "params": {
              "targetController": "opponent",
              "effect": { "name": "playerCannot", "value": { "cannot": "playFromHand", "restricts": "characters" } }
            }
          }
        ]
      }
    ]
  }
}
