<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.1</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- LangVersion defaults per-TFM (netstandard2.1 defaults to C# 8), but the syntax
         used here (required members, init-only setters, records) needs 11+. PolySharp
         supplies the compiler-required polyfill types netstandard2.1 lacks natively. -->
    <LangVersion>12.0</LangVersion>
  </PropertyGroup>

  <!-- Nullable reference type annotations need the compiler to embed
       Microsoft.CodeAnalysis.EmbeddedAttribute on a TFM that doesn't ship it, which
       collides with PolySharp generating the same marker for its own polyfills (CS8336).
       Nullable is a compile-time analysis only - runtime behavior is identical either
       way - so it's simplest to keep full nullable checking on net8.0 and skip it for
       the netstandard2.1 leg rather than fight the generator interaction. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <!-- System.Text.Json ships as part of the net8.0 shared framework but isn't part of
         the netstandard2.1 reference assembly set - CardLoader/CardReferenceCollector
         need it explicitly for that leg. -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <!-- Auto-syncs the Unity client's plugin DLL on every netstandard2.1 build (any
       configuration, any caller - dotnet build, an IDE, build-engine-plugin.ps1) so no one
       has to remember a separate manual copy step after an engine change. Silently does
       nothing if L5R.Client isn't checked out at the expected path (e.g. CI, a machine
       without the Unity project) - never fails the engine build over a missing sibling repo.
       UnityClientPluginsDir can be overridden per-machine, e.g. `dotnet build
       -p:UnityClientPluginsDir=C:\path\to\L5R.Client\Assets\Scripts\Engine\Plugins`. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.1' and '$(UnityClientPluginsDir)' == ''">
    <UnityClientPluginsDir>$(USERPROFILE)\OneDrive\Documentos\L5R.Client\Assets\Scripts\Engine\Plugins</UnityClientPluginsDir>
  </PropertyGroup>

  <Target Name="CopyToUnityClient" AfterTargets="Build" Condition="'$(TargetFramework)' == 'netstandard2.1' and Exists('$(UnityClientPluginsDir)')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(UnityClientPluginsDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Synced $(TargetFileName) -&gt; $(UnityClientPluginsDir)" />
  </Target>

</Project>
